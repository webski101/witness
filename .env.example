# Persistent Ed25519 keys. PEM text or base64-encoded DER (PKCS8 private, SPKI public).
WITNESS_PRIVATE_KEY=
WITNESS_PUBLIC_KEY=

# Durable SQLite path. Defaults to ./data/witness.sqlite.
WITNESS_DB_PATH=

# SharedOS Cloud development/project key. Audit events are exported after each trial.
SHAREDOS_KEY=

# Optional override. Defaults to the official SharedOS Cloud audit endpoint.
SHAREDOS_AUDIT_URL=https://www.sharedos.ai/v1/audit/events
